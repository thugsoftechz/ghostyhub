[Unit]
Description=Gaming Optimization and Hardware Detection Service
Before=display-manager.service
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/hardware_detect.py
ExecStart=/usr/local/bin/optimize.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
